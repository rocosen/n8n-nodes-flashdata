{
  "name": "n8n-nodes-flashdata",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Google Search, News, Images, Shopping, Places and video search; YouTube transcripts, captions, metadata, channels, autocomplete and cloud downloads for n8n.",
  "license": "MIT",
  "homepage": "https://flashdata.dev/docs/sources/google_search?utm_source=n8n&utm_medium=integration&utm_campaign=intent_gtm_2026q4&utm_content=google_search-package",
  "keywords": [
    "n8n-community-node-package",
    "flashdata",
    "google-search",
    "youtube",
    "transcript",
    "google-news",
    "google-images",
    "google-shopping",
    "google-places",
    "google-videos",
    "youtube-search",
    "youtube-captions",
    "youtube-metadata",
    "youtube-channel",
    "youtube-autocomplete",
    "youtube-download",
    "serp",
    "subtitles"
  ],
  "author": {
    "name": "flashdata-dev",
    "url": "https://flashdata.dev",
    "email": "rocosenyy@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocosen/n8n-nodes-flashdata.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "node test/integration.cjs",
    "format": "prettier --write credentials nodes test"
  },
  "files": [
    "dist",
    "workflows"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FlashdataApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Flashdata/Flashdata.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.0",
    "eslint": "9.32.0",
    "nock": "15.0.1",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/rocosen/n8n-nodes-flashdata/issues"
  }
}
